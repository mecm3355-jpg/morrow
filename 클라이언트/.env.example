VITE_API_URL=

# 포트원 콘솔 > 결제 연동 > 연동 관리 > 식별코드·API Keys > V1 API
# 공개 식별코드이며 서버의 PORTONE_MERCHANT_CODE와 같은 값이어야 합니다.
VITE_PORTONE_MERCHANT_CODE=

# Cloudinary Console Dashboard의 Product Environment cloud name
VITE_CLOUDINARY_CLOUD_NAME=
# Cloudinary Settings > Upload > Upload presets에서 만든 unsigned preset 이름
VITE_CLOUDINARY_UPLOAD_PRESET=
