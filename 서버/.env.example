PORT=5000
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-host>/morrow-demo?retryWrites=true&w=majority
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PORTONE_API_KEY=replace-with-your-portone-v1-api-key
PORTONE_API_SECRET=replace-with-your-portone-v1-api-secret
PORTONE_MERCHANT_CODE=replace-with-your-portone-v1-merchant-code
# 테스트 채널 결제를 검증할 때만 true로 설정합니다. 운영에서는 false를 유지하세요.
PORTONE_INCLUDE_SANDBOX_PAYMENTS=false

# 드래그앤드롭 AI 가상착장
# Vercel에서는 OIDC 토큰이 자동 제공됩니다. 로컬 실행 때만 Gateway 키를 입력하세요.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key
AI_TRYON_MODEL=openai/gpt-image-2.5-sunburst
# 브라우저 Origin을 쓸 수 없는 서버 호출을 위한 선택 설정
AI_TRYON_MANNEQUIN_URL=https://your-domain.example/products/around/mannequin-front.png
# Cloudinary 외에 상품 이미지가 저장된 허용 호스트를 쉼표로 추가합니다.
AI_TRYON_ALLOWED_IMAGE_HOSTS=
