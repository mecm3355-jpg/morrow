PORT=5000
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-host>/morrow-demo?retryWrites=true&w=majority
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PORTONE_API_KEY=replace-with-your-portone-v1-api-key
PORTONE_API_SECRET=replace-with-your-portone-v1-api-secret
PORTONE_MERCHANT_CODE=replace-with-your-portone-v1-merchant-code
# 테스트 채널 결제를 검증할 때만 true로 설정합니다. 운영에서는 false를 유지하세요.
PORTONE_INCLUDE_SANDBOX_PAYMENTS=false

